{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "preserveSymlinks": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "es2015",
        "module": "esnext",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strictPropertyInitialization": false,
        "strictNullChecks": false,
        "baseUrl": ".",
        "paths": {
            "@cnx-dev/angular-devextreme": [
                "packages/angular-devextreme/src/index.ts"
            ],
            "@cnx-dev/react-devextreme": [
                "packages/react-devextreme/src/index.ts"
            ],
            "@cnx-dev/react-mui": ["packages/react-mui/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
